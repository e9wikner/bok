# Bokföringssystem API - Environment Configuration
# Copy this file to .env and adjust values for your environment

# API Configuration
BOKFOERING_API_KEY=dev-key-change-in-production
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
DEBUG=False

# Database
DATABASE_URL=sqlite:///./bokfoering.db

# API Server (optional)
API_HOST=127.0.0.1
API_PORT=8000

# Folder-based intake (Syncthing dropzone) — off by default
DROPZONE_ENABLED=false
# Host directory bind-mounted to /app/data/dropzone. Point this at the folder
# Syncthing shares with your laptop and phone.
DROPZONE_HOST_DIR=./dropzone
DROPZONE_DIR=/app/data/dropzone
DROPZONE_SCAN_INTERVAL_SECONDS=60
DROPZONE_QUIET_SECONDS=10
DROPZONE_MAX_FILES_PER_SCAN=25

# Logging (future)
LOG_LEVEL=INFO

# Features (future)
ENABLE_VAT_REPORTING=True
ENABLE_K2_EXPORT=True
