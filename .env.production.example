# Copy this file to .env.production before deployment.
# Replace BOKFOERING_API_KEY, JWT_SECRET, and AUTH_PASSWORD before real use.
# The values below are placeholders, not safe production secrets.

# Backend
DATABASE_URL=sqlite:////app/data/bokfoering.db
DEBUG=False
BOKFOERING_API_KEY=replace-with-a-long-random-agent-api-key
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-admin-password

# CORS is only needed when browsers call the API directly from another origin.
# If the frontend uses same-origin /api rewrites, set this to the frontend origin
# or leave it restrictive for other LAN clients.
CORS_ORIGINS=http://localhost:3000,http://SERVER_IP:3000

# Frontend - LAN/default setup from DEPLOYMENT.md
# Leave NEXT_PUBLIC_API_URL empty to make the browser call same-origin /api.
# The Next.js server then proxies /api to BACKEND_URL inside Docker Compose.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://api:8000

# Optional public-domain HTTPS settings.
# Only needed when using docker-compose.prod.yml with public DNS and Traefik.
APP_DOMAIN=app.localhost
API_DOMAIN=api.localhost
LETSENCRYPT_EMAIL=admin@example.com

# Optional backup/S3 settings. Not required for first LAN deployment.
# AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=s3.amazonaws.com
